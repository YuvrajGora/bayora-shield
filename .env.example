# Bayora Shield - Environment Configuration Template

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Session Configuration
# Duration in hours before server-issued session tokens expire (default: 8)
SESSION_DURATION_HOURS="8"

# Local Demo Account Passwords
# These configure server-side salted PBKDF2 credentials for local evaluation.
ADMIN_PASSWORD="bayora-admin-2026!"
RED_TEAM_PASSWORD="bayora-red-2026!"
BLUE_TEAM_PASSWORD="bayora-blue-2026!"

# Optional: Host URL for self-referential endpoints
APP_URL="http://localhost:3000"
